# Transcend – Campus Facility Portal Frontend Environment Variables
# Copy this file to .env and replace the values with your actual credentials.

# Backend API URL - REQUIRED for production
# In development: http://localhost:5000/api
# In production: your Render backend URL, e.g. https://facilities-portal.onrender.com/api
VITE_API_URL=https://facilities-portal.onrender.com/api

# Supabase credentials (legacy - only if still needed)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

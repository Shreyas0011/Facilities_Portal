# Transcend – Campus Facility Portal Frontend Environment Variables
# Copy this file to .env and replace the values with your actual credentials.

# Your Supabase Project URL (found under Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public/Anon API Key (found under Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API base URL (no trailing slash)
# Production:  https://facilities-portal.onrender.com/api
# Local dev:   http://localhost:5000/api  (used as fallback if this is unset)
VITE_API_URL=https://facilities-portal.onrender.com/api
